# Copy this file to ".env" and fill in your keys (see SETUP.md).
# Never share your .env file with anyone.

# --- YouTube (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook + Instagram (developers.facebook.com > your app > App settings > Basic) ---
META_APP_ID=
META_APP_SECRET=
# Only if your app uses "Facebook Login for Business" (see SETUP.md step 4):
META_CONFIG_ID=

# Optional
PORT=8000
